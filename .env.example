# Copy to .env and fill in. All client-side vars must be prefixed with VITE_.

# Backend API base URL. Local default (http://localhost:8080/api) is used if empty.
# In prod (Vercel), set to https://<seu-backend>.onrender.com/api
VITE_API_URL=

# Google OAuth client id (optional — Google login is disabled if empty)
VITE_GOOGLE_CLIENT_ID=

# Discord OAuth
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
